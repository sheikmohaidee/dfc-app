# ---------------------------------------------------------------------------
# Secrets — NEVER commit these.
# The Firebase *service account* key grants full admin access to the project.
# It belongs on a server (or in a secret manager), never in an app bundle.
# ---------------------------------------------------------------------------
*firebase-adminsdk*.json
service-account*.json
.env
.env.*
!.env.example
google-services.json
GoogleService-Info.plist

# Dependencies
node_modules/
.pnp
.pnp.js

