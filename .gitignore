dist/
build/
.next/
out/
.expo/
.expo-shared/
*.tsbuildinfo
android/
ios/

# Runtime
.firebase/
firebase-debug.log
firestore-debug.log
ui-debug.log
*.log
npm-debug.log*
yarn-error.log*

