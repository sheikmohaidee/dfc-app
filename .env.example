# ---------------------------------------------------------------------------
# DFC environment — copy to .env and fill in from the Firebase console.
#
#   Firebase console -> Project settings -> General -> Your apps
#
# These are Firebase *client* config values. They are public by design and ship
# inside the app bundle; they are not secrets. What protects your project is
# Firestore/Storage rules + App Check, not hiding these.
#
# The service-account JSON in this repo root is a DIFFERENT thing: it is a real
# secret, server-only, and is git-ignored. Never put it in a mobile app.
# ---------------------------------------------------------------------------

# --- Shared Firebase client config -----------------------------------------
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=dfc-app-bdb4e.firebaseapp.com
FIREBASE_PROJECT_ID=dfc-app-bdb4e
FIREBASE_STORAGE_BUCKET=dfc-app-bdb4e.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# --- Expo (must be EXPO_PUBLIC_* to reach the client bundle) ----------------
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=dfc-app-bdb4e.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=dfc-app-bdb4e
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=dfc-app-bdb4e.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_GEMINI_MODEL=gemini-2.5-flash
# reCAPTCHA / App Attest / Play Integrity are configured per-platform; see README
EXPO_PUBLIC_APPCHECK_DEBUG_TOKEN=

# --- Next.js admin web ------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=dfc-app-bdb4e.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=dfc-app-bdb4e
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=dfc-app-bdb4e.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# --- Server-only (admin SDK, seeding, Cloud Functions) ----------------------
# Absolute path to the service-account JSON. Keep it OUTSIDE any app bundle.
GOOGLE_APPLICATION_CREDENTIALS=./dfc-app-bdb4e-firebase-adminsdk-fbsvc-d4f4d66081.json

# --- Maps (rider routing + live tracking) -----------------------------------
# Android needs a Google Maps SDK key; iOS uses Apple Maps by default and only
# needs a key if you switch the provider to Google.
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_KEY=
EXPO_PUBLIC_GOOGLE_MAPS_IOS_KEY=
# Optional: Directions API key for real road polylines instead of straight legs.
EXPO_PUBLIC_GOOGLE_DIRECTIONS_KEY=
